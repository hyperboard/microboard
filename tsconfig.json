{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "types": ["bun-types"],
    "jsx": "react",
    "strict": true,
    "declaration": true,
    "declarationDir": "dist/types",
    "outDir": "dist",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "baseUrl": "src",
    "paths": {
      "*": ["*", "*.js", "*.ts", "*.tsx"],
      "*/": ["./*"],
      "api/*": ["./api/*"],
      "Color": ["./Color/index.ts"],
      "Color/*": ["./Color/*"],
      "Camera/*": ["./Camera/*"],
      "Events/*": ["./Events/*"],
      "Items/*": ["./Items/*"],
      "HTMLAdapter/*": ["./HTMLAdapter/*"],
      "Keyboard/*": ["./Keyboard/*"],
      "Pointer/*": ["./Pointer/*"],
      "Presence/*": ["./Presence/*"],
      "Selection/*": ["./Selection/*"],
      "SpatialIndex/*": ["./SpatialIndex/*"],
      "Tools/*": ["./Tools/*"],
      "types/*": ["./types/*"],
      "Geometry/*": ["./Geometry/*"],
      "Validators/*": ["./Validators/*"],
      "canvas2d-geometry-ir": ["../../Canvas2DGeometryIR/src/index.ts"],
      "web-component-json-codec": ["../../WebComponentJSONCodec/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
